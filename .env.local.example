# Copy this file to .env in the repository root. No apps/*/.env or setup.sh needed.
# Use the address other computers will open, without a trailing slash.
WEB_URL=http://10.147.19.203:17239
LISTEN_HTTP_PORT=17239
DATA_DIR=./data

# Generate each value once with: openssl rand -hex 32
# Keep these values across restarts and upgrades.
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

# Optional overrides; internal service addresses are handled by Compose.
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
AWS_ACCESS_KEY_ID=plane-storage
AWS_SECRET_ACCESS_KEY=plane-storage-secret
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=52428800
GUNICORN_WORKERS=2

# SMTP is optional. Browser setup and password login work with EMAIL_HOST empty.
# These seed first-run settings; later edits are made in /god-mode/.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
